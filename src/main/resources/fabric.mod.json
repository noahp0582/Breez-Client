{
	"schemaVersion": 1,
	"id": "breez-client",
	"version": "${version}",
	"name": "Breez Client",
	"description": "Breez Client: a standalone utility client for Minecraft 1.21.11.",
	"authors": [
		"noahp"
	],
	"contact": {
		"homepage": "https://github.com/noahp0582/Breez-Client",
		"sources": "https://github.com/noahp0582/Breez-Client"
	},
	"license": "MIT",
	"icon": "assets/breez-client/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"breezeclient.breezeclient.BreezClient"
		],
		"client": [
			"breezeclient.breezeclient.client.BreezClientClient"
		]
	},
	"mixins": [
		"breez-client.mixins.json",
		{
			"config": "breez-client.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}